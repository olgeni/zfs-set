#compdef zfs-set
# zsh completion for zfs-set(1). Install in a directory of $fpath (e.g.
# /usr/local/share/zsh/site-functions/_zfs-set).

_zfs_set_datasets() {
  local -a ds
  ds=(${(f)"$(zfs list -H -o name -t filesystem,volume 2>/dev/null)"})
  _describe -t datasets 'dataset' ds
}

_zfs_set_props() {
  local -a props
  props=(${(f)"$(zfs-set -catalogue 2>/dev/null | awk '/^  [a-z]/ { print $1 }' | grep -v '[@#]$')"})
  _describe -t properties 'property' props
}

_zfs_set_assign() {
  # PROP=VALUE: the property, then its values when the catalogue lists them
  if compset -P 1 '*='; then
    local prop=${IPREFIX%=}
    local -a vals
    vals=(${(f)"$(zfs-set -describe $prop 2>/dev/null | awk '/^    [a-z0-9]/ { print $1 }')"})
    if (( ${#vals} )); then
      _describe -t values 'value' vals
    else
      _message 'value'
    fi
  else
    local -a props
    props=(${(f)"$(zfs-set -catalogue 2>/dev/null | awk '/settable/ { print $1 }' | grep -v '[@#]$')"})
    _describe -t properties 'property' props -S =
  fi
}

_arguments -s \
  '-version[print version and exit]' \
  '-list[print every property with value, source and meaning]' \
  '-local[with -list: only the properties set here]' \
  '-get[print the named properties]:property:_sequence _zfs_set_props' \
  '*-set[set PROP=VALUE]:assignment:_zfs_set_assign' \
  '*-inherit[clear PROP (inherit or default)]:property:_zfs_set_props' \
  '-S[with -inherit: revert to the received value]' \
  '-r[with -set: children inherit it; with -inherit: zfs inherit -r; with -dump: descendants too]' \
  '-u[with -set: change mountpoint/sharenfs without mounting/sharing (zfs set -u)]' \
  '-tree[the property on every ancestor and overriding descendant]:property:_zfs_set_props' \
  '-where[every dataset that sets PROP itself]:property:_zfs_set_props' \
  '-dump[JSON snapshot of the properties set here]' \
  '-restore[restore a -dump snapshot]:file:_files' \
  '-catalogue[print the property catalogue]' \
  '-describe[describe one property]:property:_zfs_set_props' \
  '-n[dry run: print the zfs commands]' \
  '-y[apply without asking]' \
  '-check[dry run, exit 3 if anything would change]' \
  '-json[JSON output]' \
  '-lenient[accept unknown property names]' \
  '1:dataset:_zfs_set_datasets'
